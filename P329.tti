OL,0,        ECIMSBWebfax 1   F329A1788243953
OL,1,W5j 5Q5 7575747575x0w1w1 w17571
OL,2,W//%*// //%Q-$-%%%-!-%%%" ,%-$ -$%%-% ,,
OL,3,GNEWSALollipop men and women to wear
OL,4,Abody-worn cameras
OL,5,
OL,6,FWest Sussex County Council's cabinet
OL,7,Fmember for highways and transport,
OL,8,FErika Woodhurst-Trueman, said:
OL,9,F"Everyone has the right to feel safe
OL,10,Fwhile carrying out their work, and
OL,11,Fthese cameras will help protect our
OL,12,Fcrossing patrol staff while also
OL,13,Fencouraging safer behaviour from
OL,14,Fdrivers.
