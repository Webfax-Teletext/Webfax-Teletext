OL,0,        ECIMSBWebfax 1   F403A1788413204
OL,1,W5j 5Q7kj 5j js17kjc15 js57kj#4
OL,2,W//%*// //%Q%**,-. *,$%**,%-,* %%**,! ,,
OL,3,GNEWSAHeritage trams return 'hopeful'
OL,4,Afor light trail
OL,5,
OL,6,FLea Harrison, of Blackpool Transport,
OL,7,Fsaid it was hoping for an October
OL,8,Freturn but recent inspections had found
OL,9,F"more significant work" was needed
OL,10,Fbefore operational trams could be
OL,11,Fsafely returned to service.
