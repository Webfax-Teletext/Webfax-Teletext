OL,0,        ECIMSBWebfax 1   F365A1793863554
OL,1,W5j 5Q7+ js17kjc15 js57kj#4
OL,2,W//%*// //%Q-. *,$%**,%-,* %%**,! ,$A(E)
OL,3,GNEWSAStudent drowned after leaving
OL,4,Aambulance - inquest
OL,5,
OL,6,FThe Loughborough University student was
OL,7,Ffound by a member of the public lying
OL,8,Fin the street at 22:50 GMT. He was
OL,9,Fassessed by the crew and it was
OL,10,Fconcluded he was intoxicated, "had
OL,11,Fmental capacity and had no significant
OL,12,Ftraumatic injury" - but coroner Louise
OL,13,FPinder said "further interventions"
OL,14,Fshould have been considered.
OL,16,FSharma left the ambulance at 23:42,
OL,17,Fbefore getting lost in a car park and
OL,18,Fthen falling into the "fast flowing"
OL,19,FRiver Soar.
OL,23,APub: 04-NovQppppppppppppppppppppppG2/2
