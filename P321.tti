OL,0,        ECIMSBWebfax 1   F321A1793044565
OL,1,W5j 5Q5 7575747575x0w1w1 w17571
OL,2,W//%*// //%Q-$-%%%-!-%%%" ,%-$ -$%%-% ,,
OL,3,GNEWSAWoman on chemotherapy ineligible
OL,4,Afor cancer drug
OL,5,
OL,6,FLaura Stanford, from Minster on the
OL,7,FIsle of Sheppey in Kent, who recently
OL,8,Fbecame a grandmother and has a daughter
OL,9,Fwho is due to get married this
OL,10,FDecember, said she cannot afford to get
OL,11,Fthe drug privately.
OL,13,FA spokesperson for NHS England said:
OL,14,F"We recognise how important access to
OL,15,FEnhertu is for people living with
OL,16,Fsecondary breast cancer and their
OL,17,Ffamilies."
