OL,2,W//%*// //%Q-$-%%%-!-%%%" ,%-$ -$%%-% ,,
OL,3,GNEWSA'I owe #70k repayments on #42k
OL,4,Astudent loan'
OL,5,
OL,6,FNow pregnant with her first child, she
OL,7,Fsays while her payments will pause
OL,8,Fwhile her earnings reduce on maternity
OL,9,Fleave, the interest on her debt will
OL,10,Fcontinue to grow.
OL,12,FThe government says it is taking action
OL,13,Fto improve the student loan system,
OL,14,Fincluding raising the repayment
OL,15,Fthreshold for those on Plan 2.
