PN,38509
SC,0009
CT,2,C
PS,c008
OL,0,        ECIMSBWebfax 1   F385A1786598357
OL,3,CHampshire astronomy enthusiast
OL,4,Ctravelling over 1000 miles to watch
OL,5,Csolar eclipse
OL,7,F"I can't believe it's happening again".
OL,1,W~s1x0~s1~s hw1~k4~c1 hw}h7}j7}   G9/9
