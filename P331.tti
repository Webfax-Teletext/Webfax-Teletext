PN,33106
SC,0006
CT,2,C
PS,c008
OL,0,        ECIMSBWebfax 1   F331A1785514721
OL,3,CBlind man who drink-drove 150 miles
OL,4,C'followed HGV lights'
OL,6,FThe offence of dangerous driving
OL,7,Fcarries a mandatory disqualification.
OL,8,FThe precise length of Hall's ban is
OL,9,Fset to be fixed at the sentencing
OL,10,Fhearing.
OL,1,Woz5~k4{$z%~s1z5jw=hw1         G6/6
