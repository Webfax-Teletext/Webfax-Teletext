FL,416,410,140,120,000,100
PN,41503
SC,0003
CT,2,C
PS,c008
OL,0,        ECIMSBWebfax 1   F415A1785417510
OL,3,CTaoiseach defends judiciary system
OL,4,Camid unionist backlash over bomb case
OL,5,CBail
OL,7,FThe car was stopped on the N2 at
OL,8,FAclint, Carrickmacross, Co Monaghan,
OL,9,Flast Wednesday.
OL,11,FDuring a search of the vehicle, a bag
OL,12,Fwas discovered in the rear seat that
OL,13,Fcontained an amount of Semtex military
OL,14,Fgrade explosive and a detonator.
OL,1,W~k4 jw=hw1 hw}h7}j7}            G3/10
OL,2,W/*% /*%/"-$+,*%/*%/*-'T(,,,,,,,,,,,,,,,
