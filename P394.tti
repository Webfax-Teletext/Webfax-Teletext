OL,0,        ECIMSBWebfax 1   F394A1786630729
OL,3,CHow and when to watch the solar
OL,4,Ceclipse in the North East and North
OL,5,CYorkshire
OL,7,F6:45pm - Sky starts to become
OL,8,Fnoticeably darker
OL,10,F7:04pm - Behaviour of animals and
OL,11,Fplants starts to be affected
OL,13,F7:07pm - Maximum eclipse
OL,15,F7:10pm - Nature returns to normal
OL,17,F7:23pm - Light levels and temperature
OL,18,Freturning to normal
OL,20,F8:01pm - Partial eclipse ends
OL,1,W~k4~s hw1~k4~c1 hw}h7}j7}        G3/7
