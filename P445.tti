OL,0,        ECIMSBWebfax 1   F445A1787062992
OL,1,W5j 5Q7kjs1 wsj#57sj  w{j#57iG2/2
OL,2,W//%*// //%Q%**,$ -,* %-.*,$%** %-& (,,,
OL,3,GNEWSARail replacement plans for
OL,4,ANewcastle to Edinburgh
OL,5,
OL,6,FGunnar Lindahl, joint operations
OL,7,Fdirector for Network Rail and LNER,
OL,8,Fsaid: "By investing in this vital
OL,9,Finfrastructure now, we can improve
OL,10,Freliability, reduce the risk of delays
OL,11,Fcaused by flooding and failures, and
OL,12,Fhelp provide smoother, more reliable
OL,13,Fjourneys for passengers and freight
OL,14,Fservices."
