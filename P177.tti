OL,0,        ECIMSBWebfax 1   F177A1791257149
OL,1,Wj5hw1~{4k7juhw1{$             G2/2
OL,2,W+.-'"-$/*%*%*%/"-$/*%Q,,,,,,,,,,,,,,,,,
OL,3,GGrampian
OL,4,
OL,5,CWednesday:FA dry, largely sunny start
OL,6,Ffor most but increasing cloud and
OL,7,Fwinds turning more northwesterly and
OL,8,Ffreshening, bring afternoon showers,
OL,9,Fthese turning wintry over the
OL,10,Fmountains.
OL,11,
OL,12,COutlook for Thursday to Saturday:
OL,13,FMainly dry, bright start Thursday
OL,14,Fbefore increasing cloud brings
OL,15,Foccasionally evening heavy rain.
OL,16,FOvernight rain soon clears leaving
OL,17,FFriday and Saturday with sunny spells
OL,18,Fand increasingly frequent heavy,
OL,19,Fblustery showers.
OL,23,QppppppppppppppppppppGSource: Met Office
