OL,0,        ECIMSBWebfax 1   F411A1791201362
OL,1,W5j 5Q7k jjs%wsj  w{j#57i
OL,2,W//%*// //%Q%* ** %-,*,$%** %-& (,,,,,,,
OL,3,GNEWSACourt told Drumcree parade
OL,4,Adecision 'flawed' as residents mount
OL,5,Alegal challenge
OL,6,
OL,7,FResidents and protesters have
OL,8,Fperiodically blocked the road and
OL,9,Fmaintained a presence there for more
OL,10,Fthan a week
OL,12,FMeanwhile Orangemen have repeatedly
OL,13,Fattempted to complete the march but
OL,14,Fbeen have been turned back by police
OL,15,Fdue to it being unsafe to proceed
OL,23,APub: 05-OctQppppppppppppppppppppppG2/4
OL,24,ANext PageB NI NewsC Reg TVF On This Day
FL,412,410,260,120,0,100
