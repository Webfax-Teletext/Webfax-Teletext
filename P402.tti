OL,0,        ECIMSBWebfax 1   F402A1793255223
OL,1,W5j 5Q7kj 5j js17kjc15 js57kj#4
OL,2,W//%*// //%Q%**,-. *,$%**,%-,* %%**,! ,,
OL,3,GNEWSAWoman's harassment story
OL,4,Ahighlights 'safeguarding loophole'
OL,5,
OL,6,F"It's a massive national safeguarding
OL,7,Floophole", said Bev Nickson from
OL,8,FLancashire, who wants to change the DBS
OL,9,Fsystem after taking a former neighbour
OL,10,Fto court over harassment.
OL,12,FThe Home Office did not comment on the
OL,13,Fconcerns.
