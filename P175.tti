OL,0,        ECIMSBWebfax 1   F175A1790260254
OL,1,Wj5hw1~{4k7juhw1{$             G2/2
OL,2,W+.-'"-$/*%*%*%/"-$/*%Q,,,,,,,,,,,,,,,,,
OL,3,GHighlands & Eilean Siar
OL,4,
OL,5,CFriday:FA day of showers mixed with
OL,6,Fbrighter spells. Showers quite
OL,7,Ffrequent across the Hebrides and west
OL,8,FHighland districts, where
OL,9,Fthunderstorms may develop later in the
OL,10,Fday. Brisk southwest winds.
OL,11,
OL,12,COutlook for Saturday to Monday:
OL,13,FSaturday brings showers, these heavier
OL,14,Flater. Sunday starts wet and windy,
OL,15,Fbefore clearing to blustery showers
OL,16,Ffor afternoon, some turning heavy.
OL,17,FMonday brings scattered light showers
OL,18,Fand brighter spells.
OL,23,QppppppppppppppppppppGSource: Met Office
