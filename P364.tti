OL,0,        ECIMSBWebfax 1   F364A1790697353
OL,1,W5j 5Q7+ js17kjc15 js57kj#4
OL,2,W//%*// //%Q-. *,$%**,%-,* %%**,! ,$A(E)
OL,3,GNEWSATown centre balaclava ban bid to
OL,4,Atake step forward
OL,5,
OL,6,FA report from the Labour-run council
OL,7,Fstates the proposed order would
OL,8,Fprohibit wearing a face covering,
OL,9,Fincluding a scarf, balaclava or mask,
OL,10,F"for the purpose of concealing identity
OL,11,Fwhile engaging in behaviour that
OL,12,Fcauses, or is likely to cause,
OL,13,Fharassment, alarm or distress".
OL,15,FDocuments add it would not apply where
OL,16,Fcoverings are worn for "legitimate
OL,17,Fmedical, religious or cultural
OL,18,Freasons".
OL,23,APub: 29-SepQppppppppppppppppppppppG2/2
